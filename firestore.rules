rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função helper para verificar autenticação e status ativo
    function isAuthenticated() {
      return request.auth != null && request.auth.token.active == true;
    }

    // Função helper para verificar system_admin
    function isSystemAdmin() {
      return isAuthenticated() && request.auth.token.is_system_admin == true;
    }

    // Função helper para verificar tenant_id
    function belongsToTenant(tenantId) {
      return isAuthenticated() && request.auth.token.tenant_id == tenantId;
    }

    // Função helper para verificar role
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    // Função helper para verificar consultor
    function isConsultant() {
      return isAuthenticated() && request.auth.token.is_consultant == true;
    }

    // Função helper para verificar se consultor tem acesso ao tenant
    function consultantHasAccess(tenantId) {
      return isConsultant()
        && request.auth.token.authorized_tenants != null
        && tenantId in request.auth.token.authorized_tenants;
    }

    // Subcoleções que o Portal do Consultor lê pelo bloco genérico (UC-48-RN-06):
    // inventory e stock_limits (InventoryView / detalhe da clínica) e
    // solicitacoes (projeções, UC-52 RN-08). Allowlist em vez de lista de
    // exclusão — qualquer subcoleção nova nasce fechada para o consultor.
    // protocolos e financeiro têm regra própria (só com opt-in financeiro).
    function consultantReadableSubcollection(collectionId) {
      return collectionId in ['inventory', 'stock_limits', 'solicitacoes'];
    }

    // Subcoleções do tenant com leitura restrita por bloco dedicado — ficam fora
    // do fallback de leitura genérico. Toda subcoleção com dado financeiro
    // interno entra aqui (FEAT-precificacao-hora-clinica).
    function isRestrictedTenantCollection(collectionId) {
      return collectionId in ['nf_imports', 'financeiro', 'precificacao_procedimentos'];
    }

    // Opt-in financeiro ativo PARA ESTE consultor (FEAT-precificacao-hora-clinica,
    // RN-13/RN-18): o clinic_admin ligou o compartilhamento e o amarrou ao
    // consultant_id do token. Documento inexistente => negado. Troca de
    // consultor não herda o acesso.
    function consultantHasFinancialOptIn(tenantId) {
      let finPath = /databases/$(database)/documents/tenants/$(tenantId)/financeiro/custo_hora;
      return exists(finPath)
        && get(finPath).data.get('compartilhar_com_consultor', false) == true
        && get(finPath).data.get('compartilhado_com_consultant_id', null) == request.auth.token.consultant_id;
    }

    // REGRAS MULTI-TENANT - OBRIGATÓRIO

    // Documento raiz do tenant (necessário para update durante onboarding)
    match /tenants/{tenantId} {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Usuários do tenant podem ler e atualizar dados cadastrais do próprio tenant,
      // mas nunca os campos de ativação/suspensão — esses só mudam via API do system_admin
      // (POST/DELETE /api/tenants/[id]/suspend), que também desativa os usuários em cascata.
      allow read: if belongsToTenant(tenantId);
      allow update: if belongsToTenant(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['active', 'suspension', 'reactivated_at', 'reactivated_by']);

      // Consultores podem ler dados do tenant (read-only)
      allow read: if consultantHasAccess(tenantId);
    }

    // Subcoleções do tenant — fallback de LEITURA ampla para os usuários do
    // tenant em qualquer subcoleção, EXCETO as restritas (`nf_imports` etc.,
    // ver blocos dedicados abaixo). O consultor só lê a allowlist de
    // consultantReadableSubcollection (UC-48-RN-06). Sobre `nf_imports`:
    // só clinic_admin lê, defesa em profundidade — hoje nenhuma tela de
    // clinic_user/consultor precisa; decisão de produto é que o
    // compartilhamento de NF-e com o consultor, se vier a existir, será
    // opt-in explícito do clinic_admin, não o padrão).
    //
    // IMPORTANTE — `{collectionId}/{document=**}` em vez de só `{document=**}`:
    // a primeira versão desta correção usava `match
    // /tenants/{tenantId}/{document=**}` com `document[0] != 'nf_imports'`
    // (indexação do wildcard recursivo). Isso funciona para `get`, mas quebra
    // TODO `list`/query em QUALQUER subcoleção do tenant — confirmado contra
    // o Firebase Emulator: "Variable [document] is not bound in path
    // template" para `list`, porque o wildcard recursivo não é vinculável em
    // operações de lista quando usado para indexação condicional. Isso
    // derrubou UC-05/UC-51/UC-52/UC-53 em CI (PR #344) por depender de
    // `getDocs(query(...))`. `{collectionId}` é um wildcard de UM segmento
    // (não recursivo) — vinculado corretamente tanto para `get` quanto para
    // `list`, validado com `@firebase/rules-unit-testing` antes de aplicar.
    //
    // ESCRITA NÃO é concedida aqui propositalmente (achado de segurança
    // UC-13-RN-09 / UC-15-RN-07 / UC-20-RN-07 — ver
    // ONLY_FOR_DEVS/PO_BA_Docs/_MAPA-DE-BUGS-E-MELHORIAS.md): a versão
    // anterior desta regra concedia `write` irrestrito a qualquer usuário do
    // tenant para TODAS as subcoleções, e a semântica OR do Firestore entre
    // blocos `match` tornava qualquer regra dedicada mais restrita
    // (`notifications`, `settings/notifications`) inefetiva isoladamente.
    // Agora, toda escrita sensível depende de uma regra dedicada abaixo —
    // qualquer subcoleção sem bloco de escrita próprio fica fail-closed (só
    // system_admin escreve), por design, não por omissão.
    match /tenants/{tenantId}/{collectionId}/{document=**} {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Usuários do tenant podem ler qualquer subcoleção do próprio tenant,
      // exceto as restritas (nf_imports, financeiro, precificacao_procedimentos
      // — regras dedicadas abaixo).
      allow read: if belongsToTenant(tenantId) && !isRestrictedTenantCollection(collectionId);

      // Consultores: READ-ONLY e apenas na allowlist (UC-48-RN-06). nf_imports,
      // financeiro, precificacao_procedimentos e qualquer subcoleção futura
      // ficam negadas ao consultor por construção.
      allow read: if consultantHasAccess(tenantId) && consultantReadableSubcollection(collectionId);
    }

    // Regras dedicadas de ESCRITA por subcoleção do tenant — causa raiz do
    // achado UC-13-RN-09 / UC-15-RN-07 / UC-20-RN-07: a regra genérica acima
    // nunca concede `write`, então cada subcoleção sensível precisa do seu
    // próprio bloco. Leitura continua vindo do bloco genérico acima (exceto
    // nf_imports, que também restringe leitura aqui).

    // inventory — leitura ampla (bloco genérico; consultor pela allowlist);
    // escrita só clinic_admin.
    // Cobre criação de itens via NF-e (UC-10/UC-11), desativação com/sem
    // redistribuição forçada (UC-13) e consumo/reserva/liberação de estoque
    // nos fluxos de procedimento (UC-16 a UC-19) — todas essas ações já são
    // restritas a clinic_admin na UI; esta regra torna a restrição real.
    match /tenants/{tenantId}/inventory/{itemId} {
      allow write: if belongsToTenant(tenantId) && hasRole('clinic_admin');
    }

    // stock_limits — leitura ampla (InventoryView usa para badge de estoque
    // baixo, visível a clinic_admin, clinic_user e consultor pela allowlist);
    // escrita só clinic_admin (UC-15).
    match /tenants/{tenantId}/stock_limits/{limitId} {
      allow write: if belongsToTenant(tenantId) && hasRole('clinic_admin');
    }

    // protocolos — leitura ampla (listagem visível a clinic_user, sem botões
    // de ação, UC-20); criação/edição/remoção só clinic_admin.
    // Consultor: fora da allowlist do bloco genérico; lê protocolos somente
    // com o opt-in financeiro ativo para ele (D6 / UC-48-RN-06) — protocolo
    // com custo é dado financeiro.
    match /tenants/{tenantId}/protocolos/{protocoloId} {
      allow write: if belongsToTenant(tenantId) && hasRole('clinic_admin');
      allow read: if consultantHasAccess(tenantId) && consultantHasFinancialOptIn(tenantId);
    }

    // solicitacoes — leitura ampla (`/clinic/requests` visível a ambos os
    // roles; consultor pela allowlist, projeções do UC-52);
    // criação/edição/conclusão/cancelamento só clinic_admin (UC-16 a UC-19).
    match /tenants/{tenantId}/solicitacoes/{solicitacaoId} {
      allow write: if belongsToTenant(tenantId) && hasRole('clinic_admin');
    }

    // inventory_activity — leitura ampla para o tenant (dashboard "Atividade
    // Recente" é visível a clinic_admin e clinic_user; consultor não lê —
    // fora da allowlist); ESCRITA só
    // clinic_admin. Diferente das demais subcoleções deste bloco, esta regra
    // de escrita não é opcional: `writeActivityLogs` (solicitacaoService.ts)
    // grava aqui diretamente pelo client SDK, dentro das mesmas transações de
    // UC-16 a UC-19 (sempre disparadas por clinic_admin) — sem este bloco,
    // essas transações passariam a falhar com permission-denied depois que a
    // regra genérica deixou de conceder `write`.
    match /tenants/{tenantId}/inventory_activity/{activityId} {
      allow write: if belongsToTenant(tenantId) && hasRole('clinic_admin');
    }

    // nf_imports — leitura E escrita restritas a clinic_admin (defesa em
    // profundidade; nenhuma tela de clinic_user acessa esta subcoleção hoje,
    // UC-10/UC-11). Excluída do fallback de leitura genérico acima
    // (collectionId != 'nf_imports') propositalmente: diferente das outras
    // subcoleções deste bloco, aqui também restringimos LEITURA, não só
    // escrita, porque não há nenhum caso de uso documentado que exija
    // clinic_user ou consultor lendo notas fiscais importadas. Consultor
    // também fica de fora por padrão — compartilhamento de NF-e com
    // consultor, se vier a existir, será opt-in explícito do clinic_admin
    // (requisito de produto novo, fora do escopo desta correção; registrado
    // separadamente no mapa de bugs para elicitação de UC dedicado).
    match /tenants/{tenantId}/nf_imports/{nfImportId} {
      allow read, write: if belongsToTenant(tenantId) && hasRole('clinic_admin');
    }

    // financeiro — dados financeiros internos (custos fixos, Boletos Tec,
    // disponibilidade, markup — FEAT-precificacao-hora-clinica). Leitura E
    // escrita só clinic_admin; excluída do fallback de leitura genérico
    // (clinic_user e consultor NÃO leem por padrão). Consultor lê somente com
    // opt-in explícito do clinic_admin, amarrado ao consultant_id que recebeu
    // o compartilhamento. Delete só via system_admin (bloco genérico): sem
    // request.resource a condição de escrita falha.
    match /tenants/{tenantId}/financeiro/{docId} {
      allow read: if belongsToTenant(tenantId) && hasRole('clinic_admin');
      allow write: if belongsToTenant(tenantId) && hasRole('clinic_admin')
        && request.resource.data.tenant_id == tenantId
        && request.resource.data.compartilhar_com_consultor is bool;
      allow read: if consultantHasAccess(tenantId)
        && resource.data.compartilhar_com_consultor == true
        && resource.data.compartilhado_com_consultant_id == request.auth.token.consultant_id;
    }

    // precificacao_procedimentos — snapshot da precificação de cada
    // procedimento (FEAT-precificacao-hora-clinica, D10). Id do documento = id
    // da solicitação. Dado financeiro interno: leitura E escrita só
    // clinic_admin; clinic_user e consultor (mesmo com opt-in financeiro) NÃO
    // leem. A solicitação continua legível por clinic_user/consultor e por isso
    // não guarda nenhum destes valores. Delete só via system_admin (genérico).
    match /tenants/{tenantId}/precificacao_procedimentos/{solicitacaoId} {
      allow read: if belongsToTenant(tenantId) && hasRole('clinic_admin');
      allow create, update: if belongsToTenant(tenantId) && hasRole('clinic_admin')
        && request.resource.data.tenant_id == tenantId
        && request.resource.data.solicitacao_id == solicitacaoId
        && request.resource.data.forma_pagamento in ['pix_dinheiro', 'debito', 'credito']
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/solicitacoes/$(solicitacaoId));
    }

    // Regras específicas para notificações (dentro de tenants)
    match /tenants/{tenantId}/notifications/{notificationId} {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Usuários do tenant podem ler e atualizar (marcar como lida) suas notificações
      allow read, update: if belongsToTenant(tenantId);

      // Apenas admins do tenant podem criar e deletar notificações
      allow create, delete: if belongsToTenant(tenantId) && request.auth.token.role == 'clinic_admin';
    }

    // Regras específicas para configurações de notificações (dentro de tenants)
    match /tenants/{tenantId}/settings/notifications {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Usuários do tenant podem ler as configurações
      allow read: if belongsToTenant(tenantId);

      // Apenas admins do tenant podem alterar configurações
      allow write: if belongsToTenant(tenantId) && request.auth.token.role == 'clinic_admin';
    }

    // Coleção de solicitações de acesso (registro público)
    match /access_requests/{requestId} {
      // Qualquer pessoa pode criar uma solicitação (público ou autenticado)
      allow create: if true;

      // Apenas system_admin pode ler, atualizar e deletar
      allow read, update, delete: if isSystemAdmin();
    }

    // Coleção de usuários do sistema
    match /users/{userId} {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Usuários podem ler seu próprio documento
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Clinic_admin pode listar usuários do seu tenant.
      // resource.data.tenant_id força a query a ter where("tenant_id", "==", <seu_tenant_id>) —
      // sem esse filtro, a regra rejeita a query inteira (Firestore não filtra documento a
      // documento em list, só valida se a query como um todo satisfaz a condição).
      allow list: if isAuthenticated()
        && request.auth.token.role == 'clinic_admin'
        && request.auth.token.tenant_id != null
        && resource.data.tenant_id == request.auth.token.tenant_id;
    }

    // Coleção de produtos master Rennova (global, sem tenant)
    match /master_products/{productId} {
      allow read: if isAuthenticated();

      // Validação de formato no servidor -- antes, só o client validava o
      // código de 7 dígitos (validateProductCode em types/masterProduct.ts);
      // esta regra é a única camada de validação server-side deste fluxo
      // (não existe API route dedicada, a escrita é direto via client SDK).
      allow create: if isSystemAdmin()
        && request.resource.data.code.matches('^[0-9]{7}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isSystemAdmin()
        && (!('code' in request.resource.data)
            || request.resource.data.code.matches('^[0-9]{7}$'))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() > 0));
      allow delete: if isSystemAdmin();
    }

    // Coleção de produtos master (apenas system_admin pode escrever)
    match /produtos_master/{productId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    // Coleção de produtos Rennova (apenas system_admin pode escrever)
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    // Coleção de produtos pendentes de cadastro no catálogo master
    // (originados de importação de NF-e com código não encontrado em produtos_master)
    match /pending_master_products/{docId} {
      // System admins têm acesso total (leitura da fila e resolução/exclusão)
      allow read, update, delete: if isSystemAdmin();

      // Usuários do tenant podem registrar uma pendência do seu próprio tenant
      allow create: if belongsToTenant(request.resource.data.tenant_id);
    }

    // Coleção de fila de e-mails (apenas para uso interno das Cloud Functions)
    match /email_queue/{emailId} {
      // Apenas system_admin pode ler a fila de e-mails
      allow read: if isSystemAdmin();

      // Nenhum usuário pode escrever diretamente (apenas via API/Functions)
      allow write: if false;
    }

    // Coleção de tokens de reset de senha (apenas Admin SDK)
    // NUNCA acessada diretamente pelo cliente - apenas via API routes
    match /password_reset_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Templates de e-mail (UC-55) -- coleção e subcoleção `versions`, 100%
    // mediadas por Admin SDK (API routes /api/email-templates/**). A escrita
    // direta via client foi descartada (Opção A da spec): a validação de
    // variáveis permitidas por template (RF-05) precisa rodar em código, não
    // é expressável de forma confiável em regra do Firestore.
    match /email_templates/{document=**} {
      allow read, write: if false;
    }

    // Coleção de documentos legais (termos, políticas, etc.)
    match /legal_documents/{documentId} {
      // System admin lê qualquer status; demais usuários autenticados não leem
      // rascunhos (conteúdo não publicado/não revisado) -- antes, a regra
      // (isAuthenticated() sem checar status) permitia ler rascunho também.
      // 'inativo' continua legível por usuários comuns porque
      // clinic/profile/page.tsx busca o título de documentos já aceitos no
      // passado, mesmo que tenham sido desativados depois (substituídos por
      // uma versão mais nova) -- só 'rascunho' é o caso realmente sensível
      // (texto ainda não publicado/revisado).
      allow read: if isSystemAdmin()
        || (isAuthenticated() && resource.data.status != 'rascunho');

      // Validação de formato no servidor -- antes, só o client validava
      // (e nem todos os campos eram validados lá); esta regra é a única
      // camada de validação server-side deste fluxo (escrita direto via
      // client SDK, sem API route dedicada).
      allow create: if isSystemAdmin()
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.version is string && request.resource.data.version.size() > 0
        && request.resource.data.status in ['ativo', 'inativo', 'rascunho'];
      allow update: if isSystemAdmin()
        && (!('slug' in request.resource.data)
            || request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$'))
        && (!('title' in request.resource.data)
            || (request.resource.data.title is string && request.resource.data.title.size() > 0))
        && (!('version' in request.resource.data)
            || (request.resource.data.version is string && request.resource.data.version.size() > 0))
        && (!('status' in request.resource.data)
            || request.resource.data.status in ['ativo', 'inativo', 'rascunho']);
      allow delete: if isSystemAdmin();
    }

    // Coleção de aceitações de documentos pelos usuários
    match /user_document_acceptances/{acceptanceId} {
      // System admins podem ler todas as aceitações
      allow read: if isSystemAdmin();

      // Usuários podem ler suas próprias aceitações
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;

      // Usuários podem criar suas próprias aceitações
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;

      // Ninguém pode atualizar ou deletar aceitações (auditoria)
      allow update, delete: if false;
    }

    // Trilha de auditoria (UC-53) — imutável, mesmo padrão de user_document_acceptances
    match /audit_log/{logId} {
      // System admins leem tudo, cross-tenant
      allow read: if isSystemAdmin();

      // Demais usuários autenticados só leem entradas do próprio tenant
      // (entradas com tenant_id: null — ações sem escopo de clínica — nunca
      // batem aqui, já que tenantId nunca é null no token)
      allow read: if belongsToTenant(resource.data.tenant_id);

      // Só pode criar em nome de si mesmo (impede personificação em escritas client-side)
      allow create: if isAuthenticated() && request.resource.data.actor_id == request.auth.uid;

      // Ninguém pode atualizar ou deletar entradas (auditoria)
      allow update, delete: if false;
    }

    // inventory_activity em escopo de collectionGroup (RNF-05/UC-53) — a regra
    // genérica de subcoleção (tenants/{tenantId}/{collectionId}/{document=**},
    // acima) cobre get/list dentro de um tenant, mas NÃO se aplica a consultas
    // collectionGroup(): confirmado manualmente contra o Firebase Emulator que
    // uma wildcard recursiva no meio do caminho não estende automaticamente
    // para "permission-denied: No matching allow statements" em collectionGroup,
    // mesmo para isSystemAdmin() — é necessária uma regra dedicada nomeando a
    // coleção no nível do grupo. Só system_admin usa collectionGroup aqui (visão
    // cross-tenant, RF-02); clinic_admin sempre lê a subcoleção do próprio
    // tenant via collection() normal, já coberta pela regra genérica.
    match /{path=**}/inventory_activity/{activityId} {
      allow read: if isSystemAdmin();
    }

    // inventory em escopo de collectionGroup (UC-32-RN-08) — mesmo motivo da regra
    // acima: isMasterProductInUse() usa collectionGroup(db, 'inventory') para checar,
    // cross-tenant, se um produto master está em uso em algum inventário de clínica;
    // a regra genérica de subcoleção não cobre collectionGroup(). Só system_admin usa
    // essa checagem (telas de Produtos Master em (admin)).
    match /{path=**}/inventory/{itemId} {
      allow read: if isSystemAdmin();
    }

    // Configurações globais do sistema
    match /system_settings/{settingId} {
      // Qualquer usuário autenticado pode ler as configurações
      allow read: if isAuthenticated();

      // Apenas system_admin pode alterar configurações
      allow write: if isSystemAdmin();
    }

    // Coleção de consultores
    match /consultants/{consultantId} {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Consultor pode ler seu próprio perfil
      allow read: if isConsultant() && request.auth.token.consultant_id == consultantId;

      // Usuários autenticados podem buscar consultores por código (para transferência)
      allow read: if isAuthenticated();
    }

    // Coleção de reivindicações de vínculo consultor-clínica
    match /consultant_claims/{claimId} {
      // System admins têm acesso total
      allow read, write: if isSystemAdmin();

      // Consultor pode criar reivindicação
      allow create: if isConsultant();

      // Consultor pode ler suas próprias reivindicações
      allow read: if isConsultant() && resource.data.consultant_id == request.auth.token.consultant_id;

      // Clinic_admin pode ler e atualizar reivindicações para seu tenant
      allow read, update: if belongsToTenant(resource.data.tenant_id) && hasRole('clinic_admin');
    }
  }
}
